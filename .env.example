# Auth.js + Google (faculty sign-in)
# Generate secret: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional on Vercel (auto-detected); set for local:
# AUTH_URL=http://localhost:3000

# Neon Postgres (from `vercel integration add neon`)
DATABASE_URL=

# Comma-separated faculty Google emails allowed to contribute
ALLOWED_EMAILS=you@university.edu,colleague@university.edu
