# Google OAuth only (any Google account can sign in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB Atlas (Vercel Marketplace) — custom prefix geospatialskills_storage
# Production gets this automatically from the integration:
geospatialskills_storage_URL=
# Optional overrides:
# MONGODB_URI=
# GEOSPATIALSKILLS_STORAGE_DB_NAME=geospatialskills

# Optional overrides (defaults are in src/lib/config.ts)
# AUTH_URL=https://www.geospatialskills.in
# NEXT_PUBLIC_SITE_URL=https://www.geospatialskills.in
